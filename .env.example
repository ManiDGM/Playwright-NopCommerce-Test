# nopCommerce store under test (no trailing slash)
BASE_URL=http://localhost:5000

# Admin credentials — copy to .env and set real values (never commit .env)
ADMIN_EMAIL=admin@yourstore.com
ADMIN_PASSWORD=your_admin_password

# Selector convention: nopCommerce does not use data-testid.
# Prefer stable #id, name= attributes, or role+accessible name
# (e.g. #Email, #Name, #search-categories, #categories-grid).
